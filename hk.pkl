amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

steps {
  ["vp-fmt"] = (Builtins.vp_fmt) {
    fix = "vp fmt --no-error-on-unmatched-pattern {{files}}"
    check = "vp fmt --check --no-error-on-unmatched-pattern {{files}}"
  }
  ["gitleaks"] = (Builtins.gitleaks) {
    scan = "staged"
  }
  ["large-files"] {
    glob = List("**/*")
    check = "hk util check-added-large-files --maxkb=2048 {{files}}"
  }
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["case-conflicts"] = Builtins.check_case_conflict
  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    // Remove this compatibility exception when https://github.com/rhysd/actionlint/pull/694 ships.
    check = "actionlint -ignore '^unexpected key \"background\" for step to run (shell command|action)\\.' {{files}}"
  }
  ["shellcheck"] {
    glob = List("**/*.sh", "**/*.bash")
    check = "shellcheck --severity=warning {{files}}"
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["screw-claude"] {
        check = new Command {
          argv = List("node", "scripts/check-commit-message.ts", "{{commit_msg_file}}")
        }
      }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
  }
}
