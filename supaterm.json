{
  "$schema": "https://supaterm.com/schema/supaterm.json",
  "defaultThreadEnvMode": "worktree",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Start Development",
      "command": "vp run dev",
      "icon": "play"
    },
    {
      "name": "Run Test Suite",
      "command": "vp run test",
      "icon": "test"
    },
    {
      "name": "Lint",
      "command": "vp run lint",
      "icon": "lint"
    },
    {
      "name": "Typecheck",
      "command": "vp run typecheck",
      "icon": "configure"
    },
    {
      "name": "Build",
      "command": "vp run build",
      "icon": "build"
    }
  ]
}
